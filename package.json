{
  "name": "academy-builder-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Blockchain@NTU Builder Guestbook: a local-first Solidity and TypeScript learning project",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "scripts": {
    "doctor": "tsx scripts/doctor.ts",
    "chain": "anvil --host 127.0.0.1 --chain-id 31337",
    "compile": "forge build --root contracts && tsx scripts/export-abi.ts",
    "test:contract": "forge test --root contracts -vv",
    "deploy": "npm run compile && tsx scripts/deploy.ts",
    "read": "tsx scripts/interact.ts read",
    "simulate": "tsx scripts/interact.ts simulate",
    "write": "tsx scripts/interact.ts write",
    "events": "tsx scripts/interact.ts events",
    "clear": "tsx scripts/interact.ts clear",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run compile && npm run typecheck && vite build",
    "test:integration": "tsx scripts/integration.ts",
    "test:wallet": "tsx --test scripts/wallet.test.ts",
    "check": "npm run compile && npm run test:contract && npm run test:wallet && npm run typecheck && vite build",
    "test": "npm run check"
  },
  "dependencies": {
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
