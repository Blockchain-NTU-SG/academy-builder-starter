{
  "name": "academy-builder-starter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Blockchain@NTU Sepolia Registry starter: Foundry, viem and React",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "compile": "forge build && tsx scripts/export-contract.ts",
    "test": "forge test",
    "read": "tsx scripts/read.ts",
    "deploy": "npm run compile && tsx scripts/deploy.ts",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run compile && forge test && npm run build"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "rollup": "4.63.6"
  }
}
