# Ethereum Sepolia RPC; replace with your provider URL if rate-limited.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Only required for deployment. Use a disposable account with Sepolia test ETH.
# Never use a real-money account or prefix this with VITE_.
PRIVATE_KEY=
# Read-only RPC for the frontend. VITE_ variables are visible in the browser,
# so only ever put public URLs here, never keys.
VITE_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
